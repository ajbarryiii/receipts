<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: bridge/install.sh fills in __NODE__, __INSTALL_DIR__, and __LOG_DIR__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.receipts.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__INSTALL_DIR__/receipts-bridge.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/bridge.log</string>
</dict>
</plist>
