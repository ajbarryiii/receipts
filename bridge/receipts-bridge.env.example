# Receipts bridge settings. install.sh copies this to ~/.receipts-bridge.env (mode 600).

# Your Lakebed app URL (https).
RECEIPTS_URL=https://your-app.lakebed.app
# Same value as RECEIPTS_BOT_SECRET in app/.env.lakebed.server.
RECEIPTS_BOT_SECRET=

# BlueBubbles Server on this Mac.
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=

# Any long random string. Register the BlueBubbles webhook as:
#   http://127.0.0.1:8787/bluebubbles?secret=<this value>
BRIDGE_WEBHOOK_SECRET=
BRIDGE_PORT=8787

# Optional tuning.
# BRIDGE_CATCH_UP_MINUTES=5
# BRIDGE_REMINDER_MINUTES=60
# BRIDGE_LOOKBACK_HOURS=24
# BRIDGE_ALLOW_DIRECT_CHATS=false
